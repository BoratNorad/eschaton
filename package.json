{
  "name": "eschaton",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "tsx tools/validate-content.ts data",
    "build:distances": "tsx tools/build-distances.ts data/maps",
    "test": "vitest run",
    "check": "npm run typecheck && npm run validate && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
